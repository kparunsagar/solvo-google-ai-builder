# ═══════════════════════════════════════════════════════════════════
# MyUrbanDaily — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git — it's in .gitignore
# ═══════════════════════════════════════════════════════════════════

# ── Auth Service ──────────────────────────────────────────────────
# PostgreSQL (leave blank to use SQLite in dev)
DATABASE_URL=postgresql+asyncpg://mud_user:mud_password@localhost:5432/mud_db

# Redis (leave blank to use in-memory OTP store in dev)
REDIS_URL=redis://localhost:6379/0

# JWT signing secret — CHANGE THIS in production!
JWT_SECRET=change_me_to_a_long_random_string_in_production

# ── Email OTP (Gmail SMTP) ────────────────────────────────────────
# Step 1: Enable 2FA on your Gmail account
# Step 2: Go to https://myaccount.google.com/apppasswords
# Step 3: Create an App Password for "Mail" → "Other (MyUrbanDaily)"
# Step 4: Paste the 16-character generated password as SMTP_PASS below

SMTP_USER=your_gmail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# ── Booking Service ───────────────────────────────────────────────
BOOKING_DATABASE_URL=postgresql+asyncpg://mud_user:mud_password@localhost:5432/mud_booking_db

# ── Frontend (Vite) ───────────────────────────────────────────────
# Set this to your deployed backend URL in production
# VITE_API_URL=https://mud-auth-service.onrender.com

# ── Firebase ──────────────────────────────────────────────────────
# Your Firebase project config — get from:
# Firebase Console → Project Settings → General → Your apps → Firebase SDK snippet
FIREBASE_PROJECT_ID=myurbandaily-458d0
# VITE_FIREBASE_API_KEY=AIza...
# VITE_FIREBASE_AUTH_DOMAIN=myurbandaily-458d0.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=myurbandaily-458d0

# ── Admin Portal (separate repo: kparunsagar/urbandailyadmin) ─────
# The admin portal runs independently. Do NOT add admin config here.
