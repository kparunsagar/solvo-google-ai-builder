rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isValidMedia() {
      return request.resource.size < 5 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }

    // User Profile Avatars
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if isValidMedia();
    }

    // Technician KYC Documents (Aadhaar, Driving License, Trade Certificates)
    match /kyc_documents/{userId}/{fileName} {
      allow read: if true;
      allow write: if isValidMedia();
    }

    // Customer Damage Reports & Doorstep Repair Proof Photos
    match /damage_reports/{bookingId}/{fileName} {
      allow read: if true;
      allow write: if isValidMedia();
    }

    // Official Warranty Cards & Receipts
    match /receipts/{receiptId}/{fileName} {
      allow read: if true;
      allow write: if isValidMedia();
    }

    // Technician Arrival Verification Selfies & Work-site Photos
    // Path: selfies/{bookingId}/{technicianId}/{fileName}
    match /selfies/{bookingId}/{technicianId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && (request.auth.uid == technicianId || request.auth.token.role == 'admin')
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
  }
}
